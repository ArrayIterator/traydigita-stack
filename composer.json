{
    "name": "traydigita/stack",
    "description": "Stack for WordPress theme development",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Tray Digita",
            "email": "team@traydigita.com",
            "role": "Organization"
        },
        {
            "name": "ArrayIterator",
            "email": "arrayiterator@gmail.com",
            "homepage": "https://traydigita.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/log": "^1.0.1 || ^2.0 || ^3.0",
        "psr/container": "^1 || ^2",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.2",
        "phpstan/phpstan": "^2.2.8",
        "slevomat/coding-standard": "^8.22.0",
        "monolog/monolog": "^2|^3",
        "ext-simplexml": "*",
        "ext-libxml": "*"
    },
    "scripts": {
        "post-autoload-dump": [
            "php -r \"file_put_contents('vendor/.htaccess', 'Deny from all\n');\"",
            "php -r \"file_put_contents('vendor/index.php', '<?php\n// Silence is golden.\n');\"",
            "php -r \"file_put_contents('index.php', '<?php\n// Silence is golden.\n');\""
        ],
        "lint": [
            "php -r \"mkdir('.tmp');\"",
            "phpcs --standard=phpcs.xml.dist"
        ],
        "fix": [
            "php -r \"mkdir('.tmp');\"",
            "phpcbf --standard=phpcs.xml.dist"
        ],
        "phpstan": [
            "phpstan analyse --memory-limit=2G"
        ],
        "code-quality": [
            "php -r \"mkdir('.tmp');\"",
            "phpcs --standard=phpcs.xml.dist",
            "phpstan analyse --memory-limit=2G"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrayDigita\\WP\\Stack\\Source\\": "src/"
        },
        "files": [
            "compat/back-compat.php"
        ]
    }
}